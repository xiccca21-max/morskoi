# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=NavalClashBot
TELEGRAM_WEBAPP_URL=https://yourdomain.com
MAX_DEPOSIT=100000
# Опционально: публичный URL для webhook (Telegram → backend)
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# =========================
# Auth
# =========================
JWT_SECRET=change_me_super_secret_32_chars_minimum
JWT_EXPIRES_IN=24h
INITDATA_MAX_AGE_SEC=3600
INITDATA_REPLAY_TTL_SEC=3600
# production: API/WS только с валидным X-Telegram-Init-Data (false = отключить проверку)
REQUIRE_TELEGRAM_CLIENT=true

# =========================
# Database
# =========================
POSTGRES_USER=naval
POSTGRES_PASSWORD=naval_pwd
POSTGRES_DB=naval_clash
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://naval:naval_pwd@postgres:5432/naval_clash?schema=public

# =========================
# Redis
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# =========================
# Backend
# =========================
NODE_ENV=development
BACKEND_PORT=4000
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# =========================
# Game economy
# =========================
PLATFORM_RAKE_PERCENT=5
MIN_WAGER=100
# 0 = без верхнего лимита (ставка ограничена балансом игрока, потолок 1 000 000)
MAX_WAGER=0
PLACEMENT_TIMEOUT_SEC=60
TURN_TIMEOUT_SEC=20
MIN_WITHDRAW=1000
WITHDRAW_FEE_PERCENT=0
WITHDRAW_DAILY_LIMIT=50000
MM_FLEX_WAIT_SEC=30
MM_FLEX_PCT=0.1

# =========================
# Payments — Crypto Pay (@CryptoBot)
# Получить токен: открыть @CryptoBot → Crypto Pay → Create App → API Token.
# Обязателен для пополнения (без токена депозит недоступен).
# Webhook в настройках приложения CryptoBot указать на:
#   https://yourdomain.com/api/payments/cryptobot/webhook
# =========================
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_API=https://pay.crypt.bot/api
# Ключ для админских действий (обработка заявок на вывод) — вводится внутри панели
ADMIN_API_KEY=change_me_admin_key
# Секретный URL веб-панели (не /admin). Пример: https://yourdomain.com/harbor-9k2-mnx-panel
ADMIN_PANEL_PATH=harbor-9k2-mnx-panel
ADMIN_PANEL_USER=your_admin_login
ADMIN_PANEL_PASSWORD=your_strong_password_min_8_chars
# Устарело: IP-фильтр заменён логином/паролем (можно оставить пустым)
ADMIN_PANEL_IPS=
# Telegram ID админа — уведомления в личку бота (входы, бои, деньги, бэкапы)
# Несколько ID через запятую. ADMIN_ALERT_ENABLED=false — отключить поток.
ADMIN_TELEGRAM_ID=123456789
ADMIN_ALERT_ENABLED=true
# Серия входов подряд (достижения, без денежных бонусов)
DAILY_BONUS_MAX_STREAK=7
# Боты-соперники (пул живых соперников, пока мало реальных игроков)
BOTS_ENABLED=true
# Автоподбор бота в очередь на реальные деньги (по умолчанию false — только PvP)
BOT_PAID_MM=false
# 31 = «Рокки» (bot:1) + 30 уникальных личностей из пула
BOTS_COUNT=31
# Доля побед бота против игрока (нетто-плюс для площадки), ~60%
BOT_WIN_RATE=0.6
# Сколько игрок ждёт в очереди до подбора бота (сек)
BOT_MATCH_WAIT_SEC=10
# Сколько открытых публичных вызовов от ботов держать в списке одновременно
BOT_OPEN_LOBBIES=8
# Задержка хода бота: «человеческий» разброс (мгновенно … до 9с раздумий)
BOT_MIN_DELAY_MS=400
BOT_MAX_DELAY_MS=9000
BACKUP_KEEP=7
# Прокси для api.telegram.org (если провайдер блокирует)
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_BOT_POLLING=false

# =========================
# Sentry (мониторинг ошибок, опционально; пусто = выключено)
# =========================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_RELEASE=

# =========================
# Frontend (vite)
# =========================
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
VITE_TG_BOT_USERNAME=NavalClashBot
# Ссылка на поддержку (@Naval_pay_manager). Бот /support и мини-апп.
VITE_SUPPORT_URL=https://t.me/Naval_pay_manager
SUPPORT_URL=https://t.me/Naval_pay_manager
# Sentry для фронтенда (опционально; build-arg при сборке образа)
VITE_SENTRY_DSN=

# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=NavalClashBot
TELEGRAM_WEBAPP_URL=https://yourdomain.com
# Опционально: публичный URL для webhook (Telegram → backend)
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/telegram/webhook

# =========================
# Auth
# =========================
JWT_SECRET=change_me_super_secret_32_chars_minimum
JWT_EXPIRES_IN=7d

# =========================
# Database
# =========================
POSTGRES_USER=naval
POSTGRES_PASSWORD=naval_pwd
POSTGRES_DB=naval_clash
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://naval:naval_pwd@postgres:5432/naval_clash?schema=public

# =========================
# Redis
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# =========================
# Backend
# =========================
NODE_ENV=development
BACKEND_PORT=4000
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# =========================
# Game economy
# =========================
PLATFORM_RAKE_PERCENT=5
MIN_WAGER=100
MAX_WAGER=10000
PLACEMENT_TIMEOUT_SEC=60
TURN_TIMEOUT_SEC=20
MIN_WITHDRAW=1000
WITHDRAW_FEE_PERCENT=0
WITHDRAW_DAILY_LIMIT=50000
MM_FLEX_WAIT_SEC=30
MM_FLEX_PCT=0.1

# =========================
# Payments — Crypto Pay (@CryptoBot)
# Получить токен: открыть @CryptoBot → Crypto Pay → Create App → API Token.
# Обязателен для пополнения (без токена депозит недоступен).
# Webhook в настройках приложения CryptoBot указать на:
#   https://yourdomain.com/api/payments/cryptobot/webhook
# =========================
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_API=https://pay.crypt.bot/api
# Ключ для админских действий (обработка заявок на вывод)
ADMIN_API_KEY=change_me_admin_key
# В production /admin.html отдаётся только с этих IP (через X-Forwarded-For). Пусто = 404 для всех.
ADMIN_PANEL_IPS=
# Telegram ID админа — уведомления в личку бота (входы, бои, деньги, бэкапы)
# Несколько ID через запятую. ADMIN_ALERT_ENABLED=false — отключить поток.
ADMIN_TELEGRAM_ID=123456789
ADMIN_ALERT_ENABLED=true
# Серия входов подряд (достижения, без денежных бонусов)
DAILY_BONUS_MAX_STREAK=7
# Боты-соперники (только 1 бот для теста; в проде лучше BOTS_ENABLED=false)
BOTS_ENABLED=true
BOTS_COUNT=1
# Доля побед бота против игрока (нетто-плюс для площадки)
BOT_WIN_RATE=0.62
# Сколько игрок ждёт в очереди до подбора бота (сек)
BOT_MATCH_WAIT_SEC=10
# Сколько открытых публичных вызовов от ботов держать в списке
BOT_OPEN_LOBBIES=1
BOT_MIN_DELAY_MS=1000
BOT_MAX_DELAY_MS=3000
BACKUP_KEEP=7
# Прокси для api.telegram.org (если провайдер блокирует)
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_BOT_POLLING=false

# =========================
# Sentry (мониторинг ошибок, опционально; пусто = выключено)
# =========================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_RELEASE=

# =========================
# Frontend (vite)
# =========================
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
VITE_TG_BOT_USERNAME=NavalClashBot
# Ссылка на поддержку (@Naval_pay_manager). Бот /support и мини-апп.
VITE_SUPPORT_URL=https://t.me/Naval_pay_manager
SUPPORT_URL=https://t.me/Naval_pay_manager
# Sentry для фронтенда (опционально; build-arg при сборке образа)
VITE_SENTRY_DSN=

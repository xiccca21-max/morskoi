# Скопируй на VPS: cp .env.production.example .env && nano .env

NODE_ENV=production

# --- Auth ---
JWT_SECRET=замени_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# --- Telegram ---
TELEGRAM_BOT_TOKEN=токен_из_BotFather
TELEGRAM_BOT_USERNAME=MyNavalClashBot
TELEGRAM_WEBAPP_URL=https://game.твой-домен.ru
TELEGRAM_BOT_POLLING=false
# ОБЯЗАТЕЛЬНО при TELEGRAM_BOT_POLLING=false — без этого backend не стартует в prod
TELEGRAM_WEBHOOK_URL=https://game.твой-домен.ru/api/telegram/webhook
# ОБЯЗАТЕЛЬНО в prod (≥16 символов): openssl rand -hex 32 — иначе backend не стартует
TELEGRAM_WEBHOOK_SECRET=замени_openssl_rand_hex_32
# Поддержка (@Naval_pay_manager): бот /support и кнопка в мини-аппе
SUPPORT_URL=https://t.me/Naval_pay_manager
# TELEGRAM_API_ROOT=https://твой-прокси.workers.dev
# ADMIN_TELEGRAM_ID — уведомления в личку бота (входы, бои, деньги)
# ADMIN_ALERT_ENABLED=false — отключить поток уведомлений
ADMIN_TELEGRAM_ID=123456789
ADMIN_ALERT_ENABLED=true

CORS_ORIGINS=https://game.твой-домен.ru

# --- Database (SQLite по умолчанию) ---
DATABASE_URL=file:/data/naval.db
# Postgres (опционально): DATABASE_URL=postgresql://naval:secret@postgres:5432/naval

# --- Redis (рекомендуется в prod для нескольких инстансов) ---
REDIS_URL=redis://redis:6379

# --- Игра ---
PLATFORM_RAKE_PERCENT=5
MIN_WAGER=100
MAX_WAGER=10000
PLACEMENT_TIMEOUT_SEC=60
TURN_TIMEOUT_SEC=20
MIN_WITHDRAW=1000
# MAX_WITHDRAW=0 — 0 = без лимита на одну заявку
MAX_WITHDRAW=0
# MIN_DEPOSIT=0 — 0 = без минимума пополнения
MIN_DEPOSIT=0
WITHDRAW_FEE_PERCENT=0
WITHDRAW_DAILY_LIMIT=50000
# Срок жизни Telegram initData (сек). 3600 = 1 час
INITDATA_MAX_AGE_SEC=3600
# Анти-зависание: максимум пропусков ходов на матч до отмены с возвратом ставок
AFK_MATCH_MAX_TIMEOUTS=6

# --- Matchmaking ---
MM_FLEX_WAIT_SEC=30
MM_FLEX_PCT=0.1

# --- Серия входов (достижения) ---
DAILY_BONUS_MAX_STREAK=7

# --- Боты-соперники (только 1 бот для теста; в проде лучше BOTS_ENABLED=false) ---
BOTS_ENABLED=true
BOTS_COUNT=1
BOT_WIN_RATE=0.62
BOT_MATCH_WAIT_SEC=10
BOT_OPEN_LOBBIES=1
BOT_MIN_DELAY_MS=1000
BOT_MAX_DELAY_MS=3000

# --- Crypto Pay (@CryptoBot) — обязателен для пополнения ---
CRYPTO_PAY_TOKEN=токен_из_CryptoBot
# CRYPTO_PAY_API=https://pay.crypt.bot/api

# --- Admin ---
ADMIN_API_KEY=замени_длинный_ключ
BACKUP_KEEP=7
AFK_FORFEIT_TIMEOUTS=2

# --- Sentry (мониторинг ошибок, опционально; пусто = выключено) ---
# Backend DSN и frontend DSN можно сделать разными проектами в Sentry.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# APP_RELEASE=naval-clash@1.0.0
# Frontend (нужно как build-arg при сборке образа): VITE_SENTRY_DSN=
VITE_SENTRY_DSN=

# Скопируй на VPS: cp .env.production.example .env && nano .env

NODE_ENV=production

# --- Auth ---
JWT_SECRET=замени_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# --- Telegram ---
TELEGRAM_BOT_TOKEN=токен_из_BotFather
TELEGRAM_BOT_USERNAME=MyNavalClashBot
TELEGRAM_WEBAPP_URL=https://game.твой-домен.ru
TELEGRAM_BOT_POLLING=false
# TELEGRAM_API_ROOT=https://твой-прокси.workers.dev
# TELEGRAM_WEBHOOK_URL=https://game.твой-домен.ru/api/telegram/webhook
# ADMIN_TELEGRAM_ID=123456789

CORS_ORIGINS=https://game.твой-домен.ru

# --- Database (SQLite по умолчанию) ---
DATABASE_URL=file:/data/naval.db
# Postgres (опционально): DATABASE_URL=postgresql://naval:secret@postgres:5432/naval

# --- Redis (рекомендуется в prod для нескольких инстансов) ---
REDIS_URL=redis://redis:6379

# --- Игра ---
PLATFORM_RAKE_PERCENT=5
MIN_WAGER=100
MAX_WAGER=10000
PLACEMENT_TIMEOUT_SEC=60
TURN_TIMEOUT_SEC=20
MIN_WITHDRAW=100
WITHDRAW_FEE_PERCENT=0
WITHDRAW_DAILY_LIMIT=50000

# --- Matchmaking ---
MM_FLEX_WAIT_SEC=30
MM_FLEX_PCT=0.1

# --- Серия входов (достижения) ---
DAILY_BONUS_MAX_STREAK=7

# --- Боты-соперники (пока мало живых игроков) ---
BOTS_ENABLED=true
BOTS_COUNT=50
BOT_WIN_RATE=0.62
BOT_MATCH_WAIT_SEC=10
BOT_OPEN_LOBBIES=6
BOT_MIN_DELAY_MS=1000
BOT_MAX_DELAY_MS=3000

# --- Crypto Pay (@CryptoBot) — обязателен для пополнения ---
CRYPTO_PAY_TOKEN=токен_из_CryptoBot
# CRYPTO_PAY_API=https://pay.crypt.bot/api

# --- Admin ---
ADMIN_API_KEY=замени_длинный_ключ
BACKUP_KEEP=7
AFK_FORFEIT_TIMEOUTS=2
